PORT=3000
NODE_ENV=development

# Supabase — Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional no servidor: chave service_role (nunca exponha no front; ignora RLS)
# SUPABASE_SERVICE_ROLE_KEY=

# Postgres — Settings > Database > Connection string (URI)
# Modo sessão (porta 5432) costuma funcionar bem com APIs Node long-running
DATABASE_URL=postgresql://postgres.[ref]:SUA_SENHA@db.seu-projeto.supabase.co:5432/postgres

# Sequelize: use true para conexões Supabase na nuvem
DATABASE_SSL=true

# bcrypt (opcional; predefinido 10; intervalo típico 10–12)
# BCRYPT_SALT_ROUNDS=10

# JWT (obrigatório para rotas protegidas; use uma string longa e aleatória)
JWT_SECRET=gere-uma-chave-secreta-longa
# Opcional: ex. 15m, 24h, 7d (ver documentação jsonwebtoken)
JWT_EXPIRES_IN=7d
